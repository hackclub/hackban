    "@prisma/client": "^6.19.3",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "fractional-indexing": "^4.0.0",
    "framer-motion": "^14.5.0",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "next": "^15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^3.25.76"
