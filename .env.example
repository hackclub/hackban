# Copy to .env and fill in. Never commit .env.

# Next Auth — generate with: npx auth secret
AUTH_SECRET=""

# Hack Club Auth (https://auth.hackclub.com/docs/oauth-guide)
# Redirect URI: <origin>/api/auth/callback/hackclub
AUTH_HACKCLUB_ID=""
AUTH_HACKCLUB_SECRET=""
# Optional. Must match the scopes enabled on the Hack Club Auth app.
# AUTH_HACKCLUB_SCOPE="email name slack_id"

# Comma-separated emails that are always site admins (/admin)
ADMIN_EMAILS=""

# Prisma
DATABASE_URL="file:./db.sqlite"

# Where uploaded attachments are stored
UPLOAD_DIR="./uploads"
