# Copy to .env and fill in. Never commit .env.

# Next Auth — generate with: npx auth secret
AUTH_SECRET=""

# Hack Club Auth (https://auth.hackclub.com/docs/oauth-guide)
# Redirect URI: <origin>/api/auth/callback/hackclub
AUTH_HACKCLUB_ID=""
AUTH_HACKCLUB_SECRET=""
# Optional. Must match the scopes enabled on the Hack Club Auth app.
# AUTH_HACKCLUB_SCOPE="email name slack_id"

# Comma-separated emails that are always site admins (/admin)
ADMIN_EMAILS=""

# Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackban"

# Where uploaded attachments are stored
UPLOAD_DIR="./uploads"

# GitHub issue tracking (all optional). GITHUB_TOKEN raises the polling rate limit;
# the OAuth app lets people connect their own account for private repos
# (callback <origin>/api/github/callback); the webhook secret enables instant updates.
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
